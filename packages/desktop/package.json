{
  "name": "@diffra/desktop",
  "productName": "Diffra",
  "version": "0.4.0",
  "description": "Diffra 桌面端编程 agent",
  "author": "DingxinTao0417",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/node-pty-permissions.ts",
    "dev": "node scripts/changelog.ts && electron-vite dev",
    "build": "electron-vite build && node scripts/changelog.ts",
    "package": "electron-vite build && node scripts/changelog.ts && electron-builder --config electron-builder.config.ts --win --publish never",
    "package:mac": "electron-vite build && node scripts/changelog.ts && electron-builder --config electron-builder.config.ts --mac --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.extension.json && node scripts/check-success-color.ts",
    "check:colors": "node scripts/check-success-color.ts",
    "build:extension": "node scripts/build-extension.ts",
    "icon:mac": "node scripts/mac-icon.ts",
    "package:extension": "node scripts/build-extension.ts --store",
    "publish:extension": "node scripts/publish-extension.ts",
    "test": "node --test scripts/*.test.ts && electron-vite build && node scripts/changelog.ts && node scripts/build-extension.ts && playwright test --project=dev",
    "test:packaged": "pnpm run package && node scripts/build-extension.ts && playwright test --project=packaged",
    "test:packaged:mac": "pnpm run package:mac && node scripts/build-extension.ts && playwright test --project=packaged",
    "publish:release": "node scripts/publish-release.ts",
    "publish:relay": "node scripts/publish-relay.ts",
    "publish:website": "node scripts/publish-website.ts",
    "changelog": "node scripts/changelog.ts",
    "build:website": "node scripts/build-website.ts",
    "website:shots": "playwright test -c playwright.shots.config.ts",
    "stats": "node scripts/website-stats.ts"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@diffra/core": "workspace:*",
    "@diffra/relay": "workspace:*",
    "@diffra/remote": "workspace:*",
    "@iconify-json/lucide": "1.2.150",
    "@lobehub/icons": "6.15.0",
    "@open-pencil/core": "0.17.0-beta.2",
    "@open-pencil/design-jsx": "0.17.0-beta.2",
    "@open-pencil/vue": "0.17.0-beta.2",
    "@playwright/test": "~1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.12.0",
    "canvaskit-wasm": "0.41.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "diff": "^9.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.69.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-rust": "^0.0.7",
    "@ast-grep/napi": "^0.51.1",
    "node-pty": "^1.1.0"
  }
}
